# ----- Allgemein -----
NODE_ENV=development

# ----- Postgres (Dev/Prod) -----
POSTGRES_DB=wineacademy
POSTGRES_USER=wineacademy
POSTGRES_PASSWORD=change_me

# ----- Strapi -----
# Hinweis: In der lokalen Entwicklung verwendet Strapi die generierten Secrets aus `backend/.env`.
# Lass diese Variablen hier leer oder auskommentiert, sonst überschreibst du die gültigen Werte und Strapi startet evtl. nicht.
# APP_KEYS=
# API_TOKEN_SALT=
# ADMIN_JWT_SECRET=
# JWT_SECRET=
HOST=0.0.0.0
PORT=1337

# Strapi DB-Konfiguration
DATABASE_CLIENT=postgres
DATABASE_HOST=db_dev
DATABASE_PORT=5432
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USERNAME=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_SSL=false
CRON_ENABLED=true

# Öffentliche URLs
PUBLIC_URL=http://localhost:1337

# ----- Next.js -----
NEXT_PUBLIC_API_URL=http://localhost:1337
# Für serverseitige Calls (SSR) innerhalb des Dev-Netzwerks
API_INTERNAL_URL=http://backend:1337
# Optional: nutzt den Next.js-Proxy unter /api/… (z. B. wenn NEXT_PUBLIC_API_URL=/api gesetzt wird)
API_PROXY_TARGET=http://localhost:1337/api

# ----- PayPal -----
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_CURRENCY=EUR

# ----- Mailserver (SMTP) -----
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=passwort
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_ALLOW_SELF_SIGNED=false
EMAIL_FROM="Wine Academy Hamburg <noreply@wineacademy.de>"
EMAIL_REPLY_TO="service@wineacademy.de"
EMAIL_TRANSPORT_ENABLED=false

# ----- SevDesk -----
SEVDESK_SYNC_ENABLED=false
SEVDESK_API_TOKEN=xxx
SEVDESK_CONTACT_PERSON_ID=
SEVDESK_CHECK_ACCOUNT_ID=
SEVDESK_SEND_TYPE=VPDF
SEVDESK_PAYMENT_SYNC_ENABLED=true
SEVDESK_PAYMENT_SYNC_CRON="*/15 * * * *"
SEVDESK_PAYMENT_SYNC_BATCH=25
SEVDESK_PAYMENT_SYNC_TZ=Europe/Berlin
SEVDESK_PAYMENT_SYNC_FORCE_INTERVAL=false
# Optional zusätzliche Steuerung für das Intervall (z. B. lokale Tests ohne Cron)
# SEVDESK_PAYMENT_SYNC_INTERVAL_MS=60000
# SEVDESK_PAYMENT_SYNC_INTERVAL_MINUTES=1

# ----- Produktion (Beispiel) -----
PROD_DOMAIN=wineacademymain.plan-p.de
PROD_NEXT_PUBLIC_API_URL=https://wineacademymain.plan-p.de/api
# In Produktion wird DATABASE_HOST=db (siehe docker-compose.yml)
