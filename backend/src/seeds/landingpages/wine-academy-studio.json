      "hintergrundfarbe": "neutral",
      "einleitung": "<div class=\"wp-block-cover alignfull is-light has-parallax has-custom-content-position is-position-bottom-center is-style-fit-image\" style=\"padding-top:15vh;padding-bottom:var(--wp--preset--spacing--content);min-height:555px;aspect-ratio:unset;\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-primary-background-color has-background-dim-0 has-background-dim\"></span><div class=\"wp-block-cover__image-background wp-image-2247 has-parallax\" style=\"background-position:50% 50%;background-image:url(https://www.wineacademy.de/wp-content/uploads/3-WineAcademy_Location_014304-scaled.jpg)\"></div><div class=\"wp-block-cover__inner-container is-layout-flow wp-block-cover-is-layout-flow\">\n<div class=\"wp-block-group alignwide has-white-color has-text-color has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group alignwide has-global-padding is-content-justification-left is-layout-constrained wp-container-core-group-is-layout-6 wp-block-group-is-layout-constrained\">\n<div aria-hidden=\"true\" class=\"wp-block-spacer\" style=\"height:280px\"></div>\n<h1 class=\"has-link-color has-text-color has-base-color wp-block-post-title wp-elements-1f73820135701125b82a0d4162906c6e\">Location</h1>\n<p class=\"has-base-color has-text-color has-link-color has-l-font-size wp-elements-be15a9e4c7daf09b7a14d40f057c0da1\">Im Herzen der Stadt Hamburg <br/>in den Räumlichkeiten der Villa Verde.</p>\n</div>\n</div>\n</div></div>\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-2 wp-block-columns-is-layout-flex\" style=\"padding-top:var(--wp--preset--spacing--content);padding-bottom:0\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:61.8%\">\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-2249\" decoding=\"async\" fetchpriority=\"high\" height=\"683\" sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-1024x683.jpg\" srcset=\"https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-1024x683.jpg 1024w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-300x200.jpg 300w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-768x512.jpg 768w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-1536x1024.jpg 1536w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-2048x1365.jpg 2048w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-480x320.jpg 480w, https://www.wineacademy.de/wp-content/uploads/121-WineAcademy_Schulung_015374-800x533.jpg 800w\" width=\"1024\"/></figure>\n<p class=\"has-m-font-size\" style=\"font-style:normal;font-weight:300\">Die Location ist perfekt für Winetastings &amp; verschiedene Kursformate ausgestattet. </p>\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-4 is-layout-flex wp-block-gallery-is-layout-flex\" style=\"margin-top:var(--wp--preset--spacing--l);margin-bottom:var(--wp--preset--spacing--l)\">\n<figure class=\"wp-block-image size-large is-style-default\"><img alt=\"\" class=\"wp-image-2253\" decoding=\"async\" height=\"683\" sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-1024x683.jpg\" srcset=\"https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-1024x683.jpg 1024w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-300x200.jpg 300w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-768x512.jpg 768w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-1536x1024.jpg 1536w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-2048x1365.jpg 2048w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-480x320.jpg 480w, https://www.wineacademy.de/wp-content/uploads/1-WineAcademy_Location_014291-1-800x533.jpg 800w\" width=\"1024\"/></figure>\n<figure class=\"wp-block-image size-large is-style-default\"><img alt=\"\" class=\"wp-image-2251\" decoding=\"async\" height=\"683\" sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-1024x683.jpg\" srcset=\"https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-1024x683.jpg 1024w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-300x200.jpg 300w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-768x512.jpg 768w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-1536x1024.jpg 1536w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-2048x1365.jpg 2048w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-480x320.jpg 480w, https://www.wineacademy.de/wp-content/uploads/4-WineAcademy_Location_014338-800x533.jpg 800w\" width=\"1024\"/></figure>\n</figure>\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-1 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"has-m-font-size\" style=\"font-style:normal;font-weight:300\">Ein uneingeschränkter Blick zum Screen, bequeme Stühle sowie sehr gute Lichtverhältnisse lassen einen Kurstag angenehm erleben.</p>\n</div>\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p style=\"font-style:normal;font-weight:300\">Mittags kurz um die Ecke, um sich zu stärken und frische Luft zu tanken – die zentrale Lage macht es möglich, ob in einem der vielen Restaurants oder in nächstgelegenen Park…</p>\n</div>\n</div>\n<figure class=\"wp-block-pullquote\" style=\"font-style:normal;font-weight:300\"><blockquote><p>Die Location ist kein klassischer oder auch nüchterner Schulungsraum. Es ist ein mit viel Liebe zum Detail, aber vor allem auf die Bedürfnisse für Verkostungen gestalteter Raum. Er strahlt Wärme aus und lädt zum Verweilen ein.”</p><cite>Thomas Möller, Kursteilnehmer</cite></blockquote></figure>\n</div>\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:38.2%\">\n<div class=\"wp-block-group has-primary-mixed-background-color has-background is-layout-flow wp-container-core-group-is-layout-8 wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading has-l-font-size\">Die Wine Academy</h2>\n<p style=\"font-style:normal;font-weight:300\">Die Wine Academy Hamburg in der Villa Verde. Sie befindet sich im Herzen der Stadt Hamburg, unweit vom belebten Schanzenviertel und dem Einwohner-starken Stadtteil Eimsbüttel. Durch die zentrale Lage besteht eine optimale Anbindung an öffentliche Verkehrsmittel, es gibt genügend Hotels sowie eine bunte Restaurantlandschaft für die tägliche Verpflegung während der Kurstage.</p>\n<p></p>\n</div>\n<figure class=\"wp-block-image aligncenter size-large is-resized\" style=\"margin-top:var(--wp--preset--spacing--m);margin-right:0;margin-bottom:var(--wp--preset--spacing--m);margin-left:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><img alt=\"\" class=\"wp-image-3229\" decoding=\"async\" height=\"731\" loading=\"lazy\" sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-1024x731.png\" srcset=\"https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-1024x731.png 1024w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-300x214.png 300w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-768x548.png 768w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-1536x1096.png 1536w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-480x343.png 480w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41-800x571.png 800w, https://www.wineacademy.de/wp-content/uploads/Bildschirmfoto-2024-09-28-um-10.39.41.png 1760w\" style=\"width:499px;height:auto\" width=\"1024\"/></figure>\n</div>\n</div>",
