{
  "collectionName": "components_system_benachrichtigungsempfaenger",
  "info": {
    "displayName": "Benachrichtigungsempfänger",
    "description": "E-Mail-Empfänger für Systembenachrichtigungen"
  },
  "attributes": {
    "bezeichnung": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Bezeichnung",
          "description": "Interner Name, z. B. „Backoffice Team“."
        }
      }
    },
    "email": {
      "type": "email",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "E-Mail-Adresse",
          "description": "Empfängeradresse für diese Benachrichtigungen."
        }
      }
    },
    "typ": {
      "type": "enumeration",
      "enum": ["bestellung", "storno", "sonstiges"],
      "default": "bestellung",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Benachrichtigungstyp",
          "description": "Steuert, bei welchen Ereignissen diese Adresse benachrichtigt wird."
        }
      }
    },
    "aktiv": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Aktiv",
          "description": "Nur aktive Einträge erhalten Benachrichtigungen."
        }
      }
    }
  }
}
