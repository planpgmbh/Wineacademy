{
  "collectionName": "components_landing_seminar_listen",
  "info": {
    "displayName": "Seminarliste",
    "description": "Liste der nächsten Seminare für eine ausgewählte Kategorie."
  },
  "attributes": {
    "anker": {
      "type": "string"
    },
    "überschrift": {
      "type": "string"
    },
    "überschriftStufe": {
      "type": "enumeration",
      "enum": ["h2", "h3", "h4"],
      "default": "h2"
    },
    "einleitung": {
      "type": "text"
    },
    "seminarkategorie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::kategorie.kategorie"
    },
    "anzahl": {
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 24
    },
    "buttonText": {
      "type": "string",
      "default": "Zum Seminar"
    },
    "mehrButtonText": {
      "type": "string",
      "default": "Mehr laden"
    },
    "mehrButtonAnzeigen": {
      "type": "boolean",
      "default": true
    },
    "hintergrundfarbe": {
      "type": "enumeration",
      "enum": [
        "neutral",
        "black",
        "wine-blue",
        "wine-blue-light",
        "wine-blue-lighter",
        "wine-blue-lightest",
        "wine-blue-dark",
        "wine-blue-darker",
        "wine-blue-darkest"
      ]
    }
  }
}
