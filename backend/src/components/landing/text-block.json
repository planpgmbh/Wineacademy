{
  "collectionName": "components_landing_text_blocks",
  "info": {
    "displayName": "Textblock",
    "description": "Überschrift mit Fließtext und optionalem CTA."
  },
  "attributes": {
    "headline": {
      "type": "string",
      "required": true
    },
    "headlineLevel": {
      "type": "enumeration",
      "enum": ["h2", "h3", "h4"],
      "default": "h2"
    },
    "sectionBackground": {
      "type": "enumeration",
      "enum": [
        "neutral",
        "black",
        "wine-blue",
        "wine-blue-light",
        "wine-blue-lighter",
        "wine-blue-lightest",
        "wine-blue-dark",
        "wine-blue-darker",
        "wine-blue-darkest"
      ]
    },
    "einleitung": {
      "type": "customField",
      "customField": "plugin::advanced-richtext.advanced-richtext"
    },
    "buttonLabel": {
      "type": "string"
    },
    "buttonLink": {
      "type": "string"
    }
  }
}
