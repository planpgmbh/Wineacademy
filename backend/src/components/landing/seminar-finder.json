{
  "collectionName": "components_landing_seminar_finders",
  "info": {
    "displayName": "Seminar Finder",
    "description": "Filtermodul zur Seminar-Suche auf Landingpages"
  },
  "options": {},
  "attributes": {
    "anker": {
      "type": "string"
    },
    "überschrift": {
      "type": "string"
    },
    "überschriftStufe": {
      "type": "enumeration",
      "enum": ["h2", "h3", "h4"],
      "default": "h2"
    },
    "hintergrundfarbe": {
      "type": "enumeration",
      "enum": [
        "neutral",
        "black",
        "wine-blue",
        "wine-blue-light",
        "wine-blue-lighter",
        "wine-blue-lightest",
        "wine-blue-dark",
        "wine-blue-darker",
        "wine-blue-darkest"
      ]
    },
    "standardKategorie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::kategorie.kategorie"
    },
    "sichtbareFilter": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::kategorie.kategorie"
    }
  }
}
