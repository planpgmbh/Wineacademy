{
  "collectionName": "components_landing_cards",
  "info": {
    "displayName": "Karte",
    "description": "Einfache Karte für Teaser-Abschnitte."
  },
  "attributes": {
    "überschrift": {
      "type": "string",
      "required": true
    },
    "einleitung": {
      "type": "string"
    },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button"
    },
    "seminarfinderKategorie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::kategorie.kategorie"
    },
    "textAlignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "left"
    },
    "verticalAlignment": {
      "type": "enumeration",
      "enum": ["top", "center", "bottom"],
      "default": "top"
    },
    "backgroundImage": {
      "type": "media",
      "allowedTypes": ["images"]
    },
    "darkModeEnabled": {
      "type": "boolean",
      "default": false
    }
  }
}
