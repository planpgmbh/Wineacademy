{
  "collectionName": "components_landing_cards",
  "info": {
    "displayName": "Karte",
    "description": "Einfache Karte für Teaser-Abschnitte."
  },
  "attributes": {
    "headline": {
      "type": "string",
      "required": true
    },
    "einleitung": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "textAlignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "left"
    },
    "verticalAlignment": {
      "type": "enumeration",
      "enum": ["top", "center", "bottom"],
      "default": "top"
    },
    "backgroundImage": {
      "type": "media",
      "allowedTypes": ["images"]
    },
    "darkModeEnabled": {
      "type": "boolean",
      "default": false
    }
  }
}
