{
  "collectionName": "termine",
  "info": {
    "singularName": "termin",
    "pluralName": "termine",
    "displayName": "Termin"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "starttag": {
      "type": "date",
      "required": true
    },
    "tageMitUhrzeit": {
      "type": "component",
      "repeatable": true,
      "component": "termin.seminartag"
    },
    "kapazitaet": {
      "type": "integer",
      "required": true,
      "default": 30
    },
    "planungsstatus": {
      "type": "enumeration",
      "enum": [
        "geplant",
        "ausgebucht",
        "abgesagt"
      ],
      "default": "geplant"
    },
    "seminar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::seminar.seminar",
      "inversedBy": "termine",
      "required": true
    },
    "standort": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::standort.standort",
      "inversedBy": "termine",
      "required": true
    },
    "buchungen": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::buchung.buchung",
      "mappedBy": "termin"
    }
  }
}
