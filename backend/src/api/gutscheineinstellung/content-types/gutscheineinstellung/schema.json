{
  "kind": "singleType",
  "collectionName": "gutscheineinstellungen",
  "info": {
    "singularName": "gutscheineinstellung",
    "pluralName": "gutscheineinstellungen",
    "displayName": "Gutscheineinstellung"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "beschreibung": {
      "type": "text"
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "heroDarkMode": {
      "type": "boolean",
      "default": false
    },
    "versandkosten": {
      "type": "string",
      "default": "0"
    },
    "minBetrag": {
      "type": "string"
    },
    "maxBetrag": {
      "type": "string"
    },
    "bookingbox": {
      "type": "component",
      "repeatable": false,
      "component": "shared.bookingbox"
    },
    "bild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.bildergalerie",
        "landing.card-grid",
        "landing.columns",
        "landing.trennlinie",
        "landing.text-block",
        "landing.seminar-liste",
        "landing.tabs",
        "landing.seminar-finder",
        "landing.seminar-produkt-karten"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    }
  }
}
