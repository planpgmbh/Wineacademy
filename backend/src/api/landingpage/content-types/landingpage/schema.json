{
  "kind": "collectionType",
  "collectionName": "landingpages",
  "info": {
    "singularName": "landingpage",
    "pluralName": "landingpages",
    "displayName": "Landingpage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titel",
      "required": true
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.hero",
        "landing.bildergalerie",
        "landing.card-grid",
        "landing.columns",
        "landing.trennlinie",
        "landing.seminar-liste",
        "landing.tabs",
        "landing.seminar-finder",
        "landing.seminar-produkt-karten"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    }
  }
}
