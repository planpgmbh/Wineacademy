{
  "kind": "collectionType",
  "collectionName": "landingpages",
  "info": {
    "singularName": "landingpage",
    "pluralName": "landingpages",
    "displayName": "Landingpage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titel",
      "required": true
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.hero",
        "landing.card-grid",
        "landing.text-block",
        "landing.icon-grid",
        "landing.hero-carousel",
        "landing.seminar-liste"
      ]
    }
  }
}
