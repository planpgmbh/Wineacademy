{
  "collectionName": "seminare",
  "info": {
    "singularName": "seminar",
    "pluralName": "seminare",
    "displayName": "Seminar"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kurzbeschreibung": {
      "type": "text"
    },
    "beschreibung": {
      "type": "richtext"
    },
    "bild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "bookingbox": {
      "type": "component",
      "repeatable": false,
      "component": "shared.bookingbox"
    },
    "heroDarkMode": {
      "type": "boolean",
      "default": false
    },
    "preis": {
      "type": "string",
      "default": "0"
    },
    "mwst": {
      "type": "boolean",
      "default": true
    },
    "kapazitaet": {
      "type": "integer"
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "termine": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::termin.termin",
      "mappedBy": "seminar"
    },
    "kategorien": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::kategorie.kategorie",
      "inversedBy": "seminare"
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.bildergalerie",
        "landing.card-grid",
        "landing.columns",
        "landing.trennlinie",
        "landing.seminar-liste",
        "landing.tabs",
        "landing.seminar-finder",
        "landing.seminar-produkt-karten"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    }
  }
}
