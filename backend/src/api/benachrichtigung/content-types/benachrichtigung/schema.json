{
  "collectionName": "benachrichtigungen",
  "info": {
    "singularName": "benachrichtigung",
    "pluralName": "benachrichtigungen",
    "displayName": "Benachrichtigungen",
    "description": "Transaktionale E-Mails inkl. Layout, Platzhaltern und Dokumentation"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Titel",
          "description": "Interner Name der Benachrichtigung; hilft bei der Auswahl im Admin, wird nicht mitversendet."
        }
      }
    },
    "anwendungsfall": {
      "type": "enumeration",
      "enum": [
        "bestellbestaetigung",
        "zahlungsbestaetigung",
        "rechnung_gutschein",
        "backoffice_benachrichtigung"
      ],
      "required": true,
      "unique": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Anwendungsfall",
          "description": "Welche Benachrichtigung hier gepflegt wird (z. B. Bestellbestätigung)."
        }
      }
    },
    "layout": {
      "type": "enumeration",
      "enum": ["default", "rechnung", "backoffice"],
      "default": "default",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Layout",
          "description": "Bestimmt das Grundgerüst der E-Mail (z. B. Standard, Rechnung oder Backoffice-Design)."
        }
      }
    },
    "beschreibung": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Beschreibung",
          "description": "Kurze interne Erklärung, wann diese Benachrichtigung verwendet wird."
        }
      }
    },
    "betreff": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Betreff",
          "description": "Betreffzeile der E-Mail; Platzhalter wie `{{kunde.vorname}}` sind erlaubt."
        }
      }
    },
    "vorschauzeile": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Vorschauzeile",
          "description": "Kurzer Text hinter dem Betreff, der im Posteingang als Vorschau erscheint."
        }
      }
    },
    "bodyHtml": {
      "type": "richtext",
      "pluginOptions": {
        "content-manager": {
          "displayName": "HTML-Inhalt",
          "description": "Gestalteter E-Mail-Inhalt mit Überschriften, Buttons usw.; Platzhalter wie `{{kunde.vorname}}` werden beim Versand ersetzt."
        }
      }
    },
    "bodyText": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Text-Inhalt",
          "description": "Einfache Textversion als Fallback für E-Mail-Clients ohne HTML-Unterstützung."
        }
      }
    },
    "platzhalter": {
      "type": "component",
      "repeatable": true,
      "component": "benachrichtigung.platzhalter",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Platzhalter",
          "description": "Dokumentation der verfügbaren Platzhalter inkl. Beschreibung und Beispielwert."
        }
      }
    },
    "testPayload": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Testdaten (JSON)",
          "description": "Zusätzliche JSON-Daten für den Testversand, z. B. verschachtelte Objekte oder Arrays (werden mit den Platzhalter-Beispielen kombiniert)."
        }
      }
    },
    "sendgridVorlagenId": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "displayName": "SendGrid-Vorlagen-ID",
          "description": "Optional: ID der dynamischen SendGrid-Vorlage; HTML/Text in Strapi dienen dann nur zur Dokumentation."
        }
      }
    },
    "aktiv": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Aktiv",
          "description": "Nur aktive Vorlagen werden für den Versand angeboten."
        }
      }
    }
  }
}
