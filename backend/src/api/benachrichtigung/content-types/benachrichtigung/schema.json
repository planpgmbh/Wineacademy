{
  "collectionName": "benachrichtigungen",
  "info": {
    "singularName": "benachrichtigung",
    "pluralName": "benachrichtigungen",
    "displayName": "Benachrichtigungen"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Titel"
        }
      }
    },
    "anwendungsfall": {
      "type": "enumeration",
      "enum": [
        "bestellbestaetigung",
        "zahlungsbestaetigung",
        "rechnung_gutschein",
        "backoffice_benachrichtigung"
      ],
      "required": true,
      "unique": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Anwendungsfall"
        }
      }
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "default",
        "rechnung",
        "backoffice"
      ],
      "default": "default",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Layout"
        }
      }
    },
    "beschreibung": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Beschreibung"
        }
      }
    },
    "betreff": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Betreff"
        }
      }
    },
    "vorschauzeile": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Vorschauzeile"
        }
      }
    },
    "bodyHtml": {
      "type": "richtext",
      "pluginOptions": {
        "content-manager": {
          "displayName": "HTML-Inhalt"
        }
      }
    },
    "bodyText": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Text-Inhalt"
        }
      }
    },
    "platzhalter": {
      "type": "component",
      "repeatable": true,
      "component": "benachrichtigung.platzhalter",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Platzhalter"
        }
      }
    },
    "testPayload": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "displayName": "Testdaten (JSON)"
        }
      }
    },
    "sendgridVorlagenId": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "displayName": "SendGrid-Vorlagen-ID"
        }
      }
    },
    "aktiv": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "content-manager": {
          "displayName": "Aktiv"
        }
      }
    }
  }
}
