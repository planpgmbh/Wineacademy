{
  "collectionName": "gutscheine",
  "info": {
    "singularName": "gutschein",
    "pluralName": "gutscheine",
    "displayName": "Gutschein"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "istTemplate": {
      "type": "boolean",
      "default": false
    },
    "beschreibung": {
      "type": "text"
    },
    "bild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "bookingbox_topline": {
      "type": "string"
    },
    "bookingbox_headline": {
      "type": "string"
    },
    "bookingbox_body": {
      "type": "text"
    },
    "gutscheininhalte": {
      "type": "component",
      "repeatable": true,
      "component": "gutschein.tab"
    },
    "code": {
      "type": "string",
      "unique": true
    },
    "typ": {
      "type": "enumeration",
      "enum": [
        "betrag",
        "prozent"
      ],
      "default": "betrag"
    },
    "wert": {
      "type": "decimal",
      "default": 0
    },
    "betrag": {
      "type": "decimal",
      "default": 0
    },
    "restwert": {
      "type": "decimal",
      "default": 0
    },
    "minBetrag": {
      "type": "decimal"
    },
    "maxBetrag": {
      "type": "decimal"
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "eingeloest": {
      "type": "boolean",
      "default": false
    },
    "eingeloestAm": {
      "type": "datetime"
    },
    "eingeloestAnzahl": {
      "type": "integer",
      "default": 0
    },
    "maxEinloesungen": {
      "type": "integer",
      "default": 0
    },
    "mindesteinkauf": {
      "type": "decimal",
      "default": 0
    },
    "maxRabatt": {
      "type": "decimal"
    },
    "gueltigBis": {
      "type": "date"
    },
    "bestellung": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bestellung.bestellung",
      "inversedBy": "gutscheine"
    }
  }
}
