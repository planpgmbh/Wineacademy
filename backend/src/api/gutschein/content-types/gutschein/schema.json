{
  "collectionName": "gutscheine",
  "info": {
    "singularName": "gutschein",
    "pluralName": "gutscheine",
    "displayName": "Gutschein"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "versandDetails": {
      "type": "component",
      "component": "bestellung.gutschein-details"
    },
    "code": {
      "type": "string",
      "unique": true
    },
    "typ": {
      "type": "enumeration",
      "enum": [
        "betrag",
        "prozent"
      ],
      "default": "betrag"
    },
    "wert": {
      "type": "decimal",
      "default": 0
    },
    "betrag": {
      "type": "decimal",
      "default": 0
    },
    "restwert": {
      "type": "decimal",
      "default": 0
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "eingeloest": {
      "type": "boolean",
      "default": false
    },
    "eingeloestAm": {
      "type": "datetime"
    },
    "eingeloestAnzahl": {
      "type": "integer",
      "default": 0
    },
    "maxEinloesungen": {
      "type": "integer",
      "default": 0
    },
    "mindesteinkauf": {
      "type": "decimal",
      "default": 0
    },
    "maxRabatt": {
      "type": "decimal"
    },
    "gueltigBis": {
      "type": "date"
    },
    "bestellung": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bestellung.bestellung",
      "inversedBy": "gutscheine"
    }
  }
}
