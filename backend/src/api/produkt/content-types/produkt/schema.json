{
  "collectionName": "produkte",
  "info": {
    "singularName": "produkt",
    "pluralName": "produkte",
    "displayName": "Produkt"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kurzbeschreibung": {
      "type": "text"
    },
    "beschreibung": {
      "type": "richtext"
    },
    "preisNetto": {
      "type": "string",
      "default": "0"
    },
    "preisBrutto": {
      "type": "string",
      "default": "0"
    },
    "versandkosten": {
      "type": "string",
      "default": "0"
    },
    "steuerSatz": {
      "type": "string",
      "default": "19"
    },
    "mwst": {
      "type": "boolean",
      "default": true
    },
    "gutschein": {
      "type": "boolean",
      "default": false
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "bild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "bookingbox_topline": {
      "type": "string"
    },
    "bookingbox_headline": {
      "type": "string"
    },
    "bookingbox_body": {
      "type": "text"
    },
    "produktinhalte": {
      "type": "component",
      "repeatable": true,
      "component": "produkt.tab"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    }
  }
}
