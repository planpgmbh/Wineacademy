{
  "collectionName": "produkte",
  "info": {
    "singularName": "produkt",
    "pluralName": "produkte",
    "displayName": "Produkt"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kurzbeschreibung": {
      "type": "text"
    },
    "beschreibung": {
      "type": "richtext"
    },
    "bookingbox": {
      "type": "component",
      "repeatable": false,
      "component": "shared.bookingbox"
    },
    "heroDarkMode": {
      "type": "boolean",
      "default": false
    },
    "preisNetto": {
      "type": "string",
      "default": "0"
    },
    "preisBrutto": {
      "type": "string",
      "default": "0"
    },
    "versandkosten": {
      "type": "string",
      "default": "0"
    },
    "steuerSatz": {
      "type": "string",
      "default": "19"
    },
    "mwst": {
      "type": "boolean",
      "default": true
    },
    "gutschein": {
      "type": "boolean",
      "default": false
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "bild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.bildergalerie",
        "landing.card-grid",
        "landing.columns",
        "landing.trennlinie",
        "landing.seminar-liste",
        "landing.tabs",
        "landing.seminar-finder",
        "landing.seminar-produkt-karten"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    }
  }
}
