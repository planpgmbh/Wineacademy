      "type": "string"
    },
    "plz": {
      "type": "string"
    },
    "stadt": {
      "type": "string"
    },
    "land": {
      "type": "enumeration",
      "enum": ["Deutschland"],
      "default": "Deutschland",
      "required": true
    },
