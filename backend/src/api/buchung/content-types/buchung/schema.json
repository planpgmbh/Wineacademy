{
  "collectionName": "buchungen",
  "info": {
    "singularName": "buchung",
    "pluralName": "buchungen",
    "displayName": "Buchung",
    "description": "Teilnehmerdaten zu einem Seminartermin innerhalb einer Bestellung"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "vorname": { "type": "string", "required": true },
    "nachname": { "type": "string", "required": true },
    "email": { "type": "email" },
    "geburtstag": { "type": "date" },
    "wsetCandidateNumber": { "type": "string" },
    "besondereBeduerfnisse": { "type": "text" },
    "anmerkungen": { "type": "text" },
    "preisNetto": { "type": "decimal" },
    "preisBrutto": { "type": "decimal" },
    "steuerSatz": { "type": "decimal" },
    "bestellung": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bestellung.bestellung",
      "inversedBy": "buchungen"
    },
    "termin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::termin.termin",
      "inversedBy": "buchungen"
    }
  }
}
