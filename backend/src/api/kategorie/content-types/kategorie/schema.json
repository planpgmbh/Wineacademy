{
  "collectionName": "kategorien",
  "info": {
    "singularName": "kategorie",
    "pluralName": "kategorien",
    "displayName": "Kategorie"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kurzbeschreibung": {
      "type": "string"
    },
    "abschnitte": {
      "type": "dynamiczone",
      "components": [
        "landing.hero",
        "landing.bildergalerie",
        "landing.card-grid",
        "landing.columns",
        "landing.trennlinie",
        "landing.seminar-liste",
        "landing.tabs",
        "landing.seminar-finder",
        "landing.seminar-produkt-karten"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    },
    "seminare": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::seminar.seminar",
      "mappedBy": "kategorien"
    }
  }
}
