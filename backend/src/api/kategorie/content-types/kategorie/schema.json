{
  "collectionName": "kategorien",
  "info": {
    "singularName": "kategorie",
    "pluralName": "kategorien",
    "displayName": "Kategorie"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "beschreibung": {
      "type": "text"
    },
    "kurzbeschreibung": {
      "type": "string"
    },
    "hintergrundbild": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "heroDarkMode": {
      "type": "boolean",
      "default": false
    },
    "seminare": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::seminar.seminar",
      "mappedBy": "kategorien"
    }
  }
}
