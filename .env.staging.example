# ----- Allgemein -----
NODE_ENV=production

# ----- Postgres (Staging) -----
POSTGRES_DB=wineacademy
POSTGRES_USER=wineacademy
POSTGRES_PASSWORD=change_me

# ----- Strapi -----
# In Staging Strapi-Secrets explizit setzen (nur Beispielwerte hier, in CI/Secrets ersetzen)
# APP_KEYS=
# API_TOKEN_SALT=
# ADMIN_JWT_SECRET=
# JWT_SECRET=
HOST=0.0.0.0
PORT=1337

# Strapi DB-Konfiguration
DATABASE_CLIENT=postgres
DATABASE_HOST=db_staging
DATABASE_PORT=5432
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USERNAME=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_SSL=false
CRON_ENABLED=true

# Öffentliche URLs
PUBLIC_URL=https://staging.wineacademy.de/api

# ----- Next.js -----
NEXT_PUBLIC_API_URL=https://staging.wineacademy.de/api
# Öffentliche Basis für Medien/Uploads (ohne /api)
NEXT_PUBLIC_ASSETS_URL=https://staging.wineacademy.de
# Für serverseitige Calls (SSR) innerhalb des Staging-Netzwerks
API_INTERNAL_URL=http://backend-staging:1337
# Interne Basis für Medien/Uploads (ohne /api) – vom Server erreichbar
ASSETS_INTERNAL_URL=http://backend-staging:1337

# ----- PayPal -----
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_CURRENCY=EUR

# ----- Mailserver (SMTP) -----
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=passwort
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_ALLOW_SELF_SIGNED=false
EMAIL_FROM="Wine Academy Hamburg <noreply@wineacademy.de>"
EMAIL_REPLY_TO="service@wineacademy.de"
EMAIL_TRANSPORT_ENABLED=false

# ----- SevDesk -----
SEVDESK_SYNC_ENABLED=false
SEVDESK_API_TOKEN=xxx
SEVDESK_CONTACT_PERSON_ID=
SEVDESK_CHECK_ACCOUNT_ID=
SEVDESK_SEND_TYPE=VPDF
SEVDESK_INVOICE_PREFIX=WA
SEVDESK_PAYMENT_SYNC_ENABLED=true
SEVDESK_PAYMENT_SYNC_CRON="*/15 * * * *"
SEVDESK_PAYMENT_SYNC_BATCH=25
SEVDESK_PAYMENT_SYNC_TZ=Europe/Berlin
SEVDESK_PAYMENT_SYNC_FORCE_INTERVAL=false
# Optional zusätzliche Steuerung für das Intervall (z. B. lokale Tests ohne Cron)
# SEVDESK_PAYMENT_SYNC_INTERVAL_MS=60000
# SEVDESK_PAYMENT_SYNC_INTERVAL_MINUTES=1

# ----- Staging Basic Auth -----
# Zugangsdaten für den Staging-Passwortschutz (nicht ins Repo committen, echte Werte in .env.staging setzen)
STAGING_BASIC_AUTH_USER=staging
STAGING_BASIC_AUTH_PASS=changeme
